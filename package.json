    "build:production": " node encryptEnv.js --env=production && node --max-old-space-size=1024 node_modules/vite/bin/vite.js build --mode encrypted && cp .htaccess dist/.htaccess",
    "preview": "node encryptEnv.mjs && node --max-old-space-size=1024 node_modules/vite/bin/vite.js preview"
  },
