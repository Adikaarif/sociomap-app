  "scripts": {
    "start": "node encryptEnv.js",
    "dev": "node encryptEnv.js && node node_modules/vite/bin/vite.js --mode encrypted ",
    "build": " node encryptEnv.js && node --max-old-space-size=1024 node_modules/vite/bin/vite.js build --mode encrypted && cp .htaccess dist/.htaccess",
    "build:staging": " node encryptEnv.js --env=staging && node --max-old-space-size=1024 node_modules/vite/bin/vite.js build --mode encrypted && cp .htaccess dist/.htaccess",
